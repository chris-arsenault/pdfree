{
  "name": "pdfree",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:release": "PDFREE_RELEASE_TESTS=1 vitest run --project release",
    "test:security": "PDFREE_SECURITY_TESTS=1 vitest run --project security",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/noto-sans": "^5.2.10",
    "@libpdf/core": "0.5.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "asn1js": "3.0.10",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.577.0",
    "node-forge": "1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "pkijs": "3.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "workbox-window": "^7.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ahara/standards": "github:chris-arsenault/ahara-standards",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/node-forge": "1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^3.0.7",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  }
